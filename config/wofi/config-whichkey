### ~/.config/wofi/config-whichkey
### Polyomino which-key 2-column horizontal card grid

width=960
height=520
location=center
show=dmenu
prompt=[ ⊞ ] WHICH-KEY
columns=2
filter_rate=100
allow_markup=true
no_actions=true
halign=fill
orientation=vertical
content_halign=fill
insensitive=true
allow_images=false
line_wrap=word
gtk_dark=true
