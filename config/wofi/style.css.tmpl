/* ~/.config/wofi/style.css.tmpl — template for scripts/theme.sh
 * Rendered directly into style.css (not @import, since wofi's GTK CSS
 * provider resolves @import relative to its process CWD, not this file's
 * location — an absolute path would work but would hardcode $HOME into a
 * git-tracked file, so full rendering is more portable).
 * Placeholders (@@NAME@@) are substituted with hex colors by theme.sh.
 */

* {
    font-family: "JetBrainsMono Nerd Font", monospace;
}

window {
    background-color: #191C24;
    color: @@TEXT@@;
    border: 2px solid @@ACCENT@@;
    border-radius: 0px;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
}

#input {
    background-color: #0F1117;
    color: @@TEXT@@;
    border: 2px solid @@ACCENT@@;
    border-radius: 0px;
    padding: 10px 14px;
    margin: 10px;
    outline: none;
    box-shadow: none;
    caret-color: @@ACCENT@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    min-height: 28px;
}

#input:focus {
    background-color: #0F1117;
    color: @@TEXT@@;
    border: 2px solid @@ACCENT@@;
    outline: none;
    box-shadow: none;
}

#input placeholder {
    color: @@ACCENT@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    opacity: 0.85;
}

#input image {
    color: @@ACCENT@@;
    border: none;
    background: transparent;
    margin-right: 10px;
}

#inner-box {
    background-color: transparent;
    margin: 4px 6px;
}

#outer-box {
    padding: 2px;
}

#scroll {
    margin: 4px;
}

#entry {
    padding: 10px 14px;
    margin: 3px 6px;
    border-radius: 0px;
    background-color: #0F1117;
    color: @@TEXT@@;
    border-left: 3px solid transparent;
    min-height: 36px;
}

#entry:selected {
    background-color: @@ACCENT@@;
    color: #0F1117;
    border-radius: 0px;
    outline: none;
    border-left: 3px solid @@TEXT@@;
}

#entry:selected #text,
#text:selected {
    color: #0F1117;
    font-weight: bold;
}

#img,
#entry image {
    margin-right: 14px;
    margin-left: 2px;
    vertical-align: middle;
}

#text {
    color: @@TEXT@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    margin: auto 0;
    padding: 2px 0;
}

#prompt {
    color: @@ACCENT@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    font-weight: bold;
    margin-right: 8px;
    padding: 0 4px;
}
