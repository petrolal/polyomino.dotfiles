/* ~/.config/wofi/style.css.tmpl — template for ThemeEngine
 * Rendered directly into style.css.
 * Placeholders (@@NAME@@) are substituted with hex colors by ThemeEngine.
 */

* {
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    outline: none;
    box-shadow: none;
    -gtk-outline-radius: 0;
}

window {
    background-color: rgba(15, 17, 26, 0.85);
    color: @@TEXT@@;
    border: 1px solid rgba(139, 92, 246, 0.35);
    border-radius: 8px;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 14px;
}

/* 2. Search / Filter Input Bar */
#input {
    background-color: @@MANTLE@@;
    color: @@TEXT@@;
    border: 1px solid rgba(139, 92, 246, 0.35);
    border-radius: 4px;
    padding: 8px 12px;
    margin: 4px 4px 10px 4px;
    outline: none;
    box-shadow: none;
    caret-color: @@ACCENT@@;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 12px;
    min-height: 32px;
}

#input:focus {
    background-color: @@MANTLE@@;
    color: @@TEXT@@;
    border: 1px solid @@ACCENT@@;
    outline: none;
    box-shadow: none;
}

#input placeholder {
    color: @@SUBTEXT0@@;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 12px;
    opacity: 0.85;
}

#input image {
    color: @@ACCENT@@;
    border: none;
    background: transparent;
    margin-right: 8px;
}

#prompt {
    background-color: @@ACCENT@@;
    color: @@BASE@@;
    border-radius: 0px;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 11px;
    font-weight: bold;
    margin-right: 8px;
    padding: 4px 8px;
}

/* 3. Content Grid (Welcome Center Bento Card Style) */
#inner-box {
    background-color: transparent;
    margin: 2px;
}

#outer-box {
    padding: 2px;
}

#scroll {
    margin: 2px;
}

#entry {
    padding: 12px 14px;
    margin: 4px;
    border-radius: 2px;
    background-color: @@SURFACE0@@;
    color: @@TEXT@@;
    border: 1px solid rgba(139, 92, 246, 0.35);
    min-height: 44px;
    transition: all 120ms ease-in-out;
}

#entry:hover {
    background-color: @@SURFACE1@@;
    border-color: rgba(168, 85, 247, 0.6);
}

#entry:selected {
    background-color: @@SURFACE1@@;
    color: @@TEXT@@;
    border-radius: 2px;
    outline: none;
    border: 1px solid @@ACCENT@@;
    box-shadow: 0 0 12px rgba(168, 85, 247, 0.25);
}

#entry:selected #text,
#text:selected {
    color: @@TEXT@@;
    font-weight: bold;
}

#img,
#entry image {
    margin-right: 12px;
    margin-left: 2px;
    vertical-align: middle;
}

#text {
    color: @@TEXT@@;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 12px;
    margin: auto 0;
    padding: 2px 0;
}

/* 4. Bottom Status & Vim Mode Bar */
#mode-indicator,
#status-bar,
#footer {
    background-color: @@MANTLE@@;
    border: 1px solid rgba(139, 92, 246, 0.35);
    border-radius: 0px;
    padding: 6px 12px;
    font-family: "JetBrainsMono Nerd Font", "JetBrains Mono", monospace;
    font-size: 10px;
    color: @@SUBTEXT0@@;
    margin: 8px 4px 2px 4px;
}

.mode-badge-normal {
    background-color: @@ACCENT@@;
    color: @@BASE@@;
    border-radius: 2px;
    font-weight: bold;
    padding: 2px 6px;
}

.mode-badge-insert {
    background-color: @@SKY@@;
    color: @@BASE@@;
    border-radius: 2px;
    font-weight: bold;
    padding: 2px 6px;
}
