/* ~/.config/wofi/style.css.tmpl — template for ThemeEngine
 * Rendered directly into style.css.
 * Placeholders (@@NAME@@) are substituted with hex colors by ThemeEngine.
 */

* {
    font-family: "JetBrainsMono Nerd Font", monospace;
}

window {
    background-color: @@BASE@@;
    color: @@TEXT@@;
    border: 1px solid rgba(139, 92, 246, 0.4);
    border-radius: 8px;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 12px;
    padding: 12px;
}

#input {
    background-color: @@MANTLE@@;
    color: @@TEXT@@;
    border: 1px solid rgba(139, 92, 246, 0.4);
    border-radius: 6px;
    padding: 8px 12px;
    margin: 4px 6px 12px 6px;
    outline: none;
    box-shadow: none;
    caret-color: @@ACCENT@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    min-height: 28px;
}

#input:focus {
    background-color: @@MANTLE@@;
    color: @@TEXT@@;
    border: 1px solid @@ACCENT@@;
    outline: none;
    box-shadow: none;
}

#input placeholder {
    color: @@SUBTEXT0@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 13px;
    opacity: 0.85;
}

#input image {
    color: @@ACCENT@@;
    border: none;
    background: transparent;
    margin-right: 10px;
}

#inner-box {
    background-color: transparent;
    margin: 4px;
}

#outer-box {
    padding: 2px;
}

#scroll {
    margin: 2px;
}

#entry {
    padding: 10px 14px;
    margin: 4px;
    border-radius: 6px;
    background-color: @@SURFACE0@@;
    color: @@TEXT@@;
    border: 1px solid rgba(139, 92, 246, 0.4);
    min-height: 36px;
}

#entry:selected {
    background-color: @@SURFACE1@@;
    color: @@TEXT@@;
    border-radius: 6px;
    outline: none;
    border: 1px solid @@ACCENT@@;
}

#entry:selected #text,
#text:selected {
    color: @@TEXT@@;
    font-weight: bold;
}

#img,
#entry image {
    margin-right: 10px;
    margin-left: 2px;
    vertical-align: middle;
}

#text {
    color: @@TEXT@@;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 12px;
    margin: auto 0;
    padding: 2px 0;
}

#prompt {
    background-color: @@ACCENT@@;
    color: @@BASE@@;
    border-radius: 4px;
    font-family: "JetBrainsMono Nerd Font", monospace;
    font-size: 11px;
    font-weight: bold;
    margin-right: 8px;
    padding: 4px 8px;
}
