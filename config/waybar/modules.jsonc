{
  // ── Floating Island segments (3 detached groups) ──
  "group/left": {
    "orientation": "horizontal",
    "modules": ["sway/workspaces", "custom/spotify"],
  },
  "group/center": {
    "orientation": "horizontal",
    "modules": ["sway/mode", "sway/window", "custom/matriz", "clock"],
  },
  "group/right": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "bluetooth",
      "network",
      "custom/matriz",
      "cpu",
      "memory",
      "battery",
      "custom/matriz",
      "tray",
      "custom/polyomino",
    ],
  },
  // trailing brand pill — click opens the polyomino launcher (power / theme / config),
  // right-click jumps straight to the Tetris power menu. Each bar object in
  // config.jsonc overrides on-click with `--output <name>` so the wofi menu
  // opens on the monitor whose pill was clicked; this bare handler is the
  // fallback for any bar without an override (menu lands on the focused output).
  "custom/polyomino": {
    "format": "POLYOMINO",
    "tooltip": false,
    "on-click": "~/.local/bin/polyomino menu",
    "on-click-right": "kitty --class=polyomino-power-menu -o font_size=14 -e ~/.local/bin/polyomino power-menu",
  },
  // waybar-battery
  "battery": {
    "interval": 30,
    "align": 0,
    "rotate": 0,
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "format-time": "{H}h {M}min",
  },
  // waybar-cpu
  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip": true,
  },
  // waybar-memory
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB",
  },

  // waybar-bluetooth
  "bluetooth": {
    "format": "󰂯 {status}",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}: {status}",
    "tooltip": true,
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "kitty -e bluetui",
  },
  // waybar-clock — center navigation capsule, dot matrix delimiter between time and date
  "clock": {
    "interval": 1,
    "align": 0,
    "rotate": 0,
    "tooltip": false,
    "format": " {:%H:%M:%S  ·  %a %d %b}",
    "on-click": "~/.local/bin/polyomino calendar",
  },
  // CAD dot matrix separator
  "custom/matriz": {
    "format": "·",
    "tooltip": false,
  },
  // waybar-idle-inhibitor
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
    "timeout": 30,
  },
  // waybar-spotify
  "custom/spotify": {
    "exec": "~/.config/waybar/spotify.sh",
    "interval": 1,
    "format": "{}",
    "tooltip": true,
    "max-length": 30,
    "on-click": "playerctl -p spotify_player playback play-pause",
    "on-click-middle": "playerctl -p spotify_player playback previous",
    "on-click-right": "playerctl -p spotify_player playback next",
    "smooth-scrolling-threshold": 1,
  },
  // waybar-mpd
  "mpd": {
    "interval": 2,
    "unknown-tag": "N/A",
    "format": "{artist} - {title} {stateIcon}",
    "format-disconnected": " Disconnected",
    "format-paused": "{artist} - {title} {stateIcon}",
    "format-stopped": "Stopped ",
    "state-icons": {
      "paused": "",
      "playing": "",
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)",
    "on-click": "mpc toggle",
    "on-click-middle": "alacritty --class 'alacritty-float,alacritty-float' --config-file ~/.config/sway/alacritty/alacritty.toml -e ncmpcpp",
    "on-click-right": "mpc next",
    "on-update": "",
    "on-scroll-up": "mpc seek +5%",
    "on-scroll-down": "mpc seek -5%",
    "smooth-scrolling-threshold": 1,
  },
  // waybar-network
  "network": {
    "interval": 5,
    "format-wifi": " {essid}",
    "format-ethernet": "󰩠 {ipaddr}/{cidr}",
    "format-linked": "󰩠 {ifname} (No IP)",
    "format-disconnected": " Disconnected",
    "format-disabled": "󰈂 Disabled",
    "format-alt": " {bandwidthUpBits} |  {bandwidthDownBits}",
    "tooltip-format": " {ifname} via {gwaddr}",
    "on-click-right": "~/.config/sway/scripts/rofi_network",
  },
  // waybar-pulseaudio
  "pulseaudio": {
    //"format": "{volume}% {icon} {format_source}",
    "format": "{icon} {volume}%",
    "format-muted": " Mute",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰗿 Mute",
    "format-source": " {volume}%",
    "format-source-muted": " Mute",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "scroll-step": 5.0,
    "on-click": "kitty -e ncpamixer",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "smooth-scrolling-threshold": 1,
  },
  // waybar-sway-mode
  "sway/mode": {
    "format": "[ MODE: {} ]",
    "tooltip": false,
  },
  // waybar-sway-window
  "sway/window": {
    "format": "{}",
    "max-length": 40,
    "icon": false,
  },
  // waybar-sway-workspaces
  "sway/workspaces": {
    "disable-scroll": true,
    "disable-click": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1:web": "[1:web]",
      "2:code": "[2:code]",
      "3:term": "[3:term]",
      "4:containers": "[4:containers]",
      "5:comms": "[5:comms]",
      "6:notes": "[6:notes]",
      "7:infra": "[7:infra]",
      "8:misc": "[8:misc]",
      "9:scratch": "[9:scratch]",
      "1": "[1:web]",
      "2": "[2:code]",
      "3": "[3:term]",
      "4": "[4:containers]",
      "5": "[5:comms]",
      "6": "[6:notes]",
      "7": "[7:infra]",
      "8": "[8:misc]",
      "9": "[9:scratch]",
      "default": "[{name}]",
    },
    "smooth-scrolling-threshold": 1,
    "disable-scroll-wraparound": false,
    "enable-bar-scroll": false,
    "disable-markup": false,
    "current-only": false,
  },
  // waybar-tray
  "tray": {
    "icon-size": 16,
    "spacing": 10,
  },
}
