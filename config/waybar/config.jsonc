// ~/.config/waybar/config.jsonc
// Production Waybar layout — Monolith TUI header bar with 1px solid bottom border.
[
  {
    "output": "HDMI-A-1",
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": ["sway/workspaces", "custom/spotify"],
    "modules-center": ["sway/mode", "sway/window", "custom/matriz", "clock"],
    "modules-right": [
      "pulseaudio",
      "bluetooth",
      "network",
      "custom/matriz",
      "cpu",
      "memory",
      "battery",
      "custom/matriz",
      "custom/notification",
      "custom/polyomino",
    ],
    "clock": {
      "interval": 1,
      "align": 0,
      "rotate": 0,
      "tooltip": false,
      "format": " {:%H:%M:%S  ·  %a %d %b}",
      "on-click": "~/.local/bin/polyomino calendar --output HDMI-A-1",
    },
    "custom/polyomino": {
      "format": "⊞ POLYOMINO",
      "tooltip": false,
      "on-click": "~/.local/bin/polyomino menu --output HDMI-A-1",
      "on-click-right": "kitty --class=polyomino-power-menu -o font_size=14 -e ~/.local/bin/polyomino power-menu",
    },
  },
  {
    "output": "eDP-1",
    "include": "~/.config/waybar/modules.jsonc",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": ["sway/workspaces", "custom/spotify"],
    "modules-center": ["sway/mode", "sway/window", "custom/matriz", "clock"],
    "modules-right": [
      "pulseaudio",
      "bluetooth",
      "network",
      "custom/matriz",
      "cpu",
      "memory",
      "battery",
      "custom/matriz",
      "custom/gamemode",
      "custom/matriz",
      "custom/notification",
      "custom/polyomino",
    ],
    "clock": {
      "interval": 1,
      "align": 0,
      "rotate": 0,
      "tooltip": false,
      "format": " {:%H:%M:%S  ·  %a %d %b}",
      "on-click": "~/.local/bin/polyomino calendar --output eDP-1",
    },
    "custom/polyomino": {
      "format": "⊞ POLYOMINO",
      "tooltip": false,
      "on-click": "~/.local/bin/polyomino menu --output eDP-1",
      "on-click-right": "kitty --class=polyomino-power-menu -o font_size=14 -e ~/.local/bin/polyomino power-menu",
    },
  },
]
