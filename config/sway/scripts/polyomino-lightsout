#!/usr/bin/env python3
"""
polyomino-lightsout — Quick Settings & Profile Matrix (Lights Out Puzzle)
Part of Polyomino Dotfiles Suite.
"""

import sys
import os
import subprocess
import termios
import tty

ESC = "\033["
RESET = f"{ESC}0m"
BOLD = f"{ESC}1m"
DIM = f"{ESC}2m"

BG_DARK = f"{ESC}48;2;15;17;26m"
BORDER_VIOLET = f"{ESC}38;2;139;92;246m"
CYAN = f"{ESC}38;2;6;182;212m"
AMBER = f"{ESC}38;2;245;158;11m"
VIOLET = f"{ESC}38;2;168;85;247m"
GREEN = f"{ESC}38;2;34;197;94m"
RED = f"{ESC}38;2;239;68;68m"
TEXT_WHITE = f"{ESC}38;2;248;250;252m"
TEXT_DIM = f"{ESC}38;2;100;116;139m"

TOGGLE_ACTIVE_BG = f"{ESC}48;2;12;74;110m"
TOGGLE_INACTIVE_BG = f"{ESC}48;2;30;41;59m"

ITEMS = [
    {"id": "wifi", "name": "Wi-Fi Radio", "glyph": "󰖩", "check": "nmcli radio wifi", "on": "nmcli radio wifi on", "off": "nmcli radio wifi off"},
    {"id": "bluetooth", "name": "Bluetooth", "glyph": "󰂯", "check": "rfkill list bluetooth | grep -q 'Soft blocked: yes' && exit 1 || exit 0", "on": "rfkill unblock bluetooth", "off": "rfkill block bluetooth"},
    {"id": "nightlight", "name": "Night Light", "glyph": "󰖔", "check": "pgrep -x wlsunset || pgrep -x gammastep", "on": "wlsunset -t 4000 -T 6500 &", "off": "pkill -x wlsunset; pkill -x gammastep"},
    {"id": "dnd", "name": "Do Not Disturb", "glyph": "󰂛", "check": "swaync-client -D 2>/dev/null | grep -q true", "on": "swaync-client -d -sw", "off": "swaync-client -d -sw"},
    {"id": "gamemode", "name": "GameMode", "glyph": "󰊴", "check": "gamemoded -s 2>/dev/null | grep -q 'is active'", "on": "polyomino gamemode on", "off": "polyomino gamemode off"},
    {"id": "audio_mute", "name": "Audio Output", "glyph": "󰕾", "check": "wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -q MUTED && exit 1 || exit 0", "on": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0", "off": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 1"},
    {"id": "mic_mute", "name": "Microphone", "glyph": "󰍬", "check": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED && exit 1 || exit 0", "on": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0", "off": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1"},
    {"id": "autotiling", "name": "Autotiling", "glyph": "󰕰", "check": "pgrep -f 'polyomino.*autotiling'", "on": "polyomino autotiling &", "off": "pkill -f 'polyomino.*autotiling'"},
    {"id": "stealth", "name": "Stealth Mode", "glyph": "󰌌", "check": "false", "on": "", "off": ""}
]

def probe_hardware_state():
    states = []
    for item in ITEMS:
        try:
            res = subprocess.run(item["check"], shell=True, timeout=1, capture_output=True)
            states.append(res.returncode == 0)
        except Exception:
            states.append(False)
    return states

def commit_hardware_state(item, turn_on):
    cmd = item["on"] if turn_on else item["off"]
    if cmd:
        try:
            subprocess.run(cmd, shell=True, timeout=2, capture_output=True)
        except Exception:
            pass

class LightsOutGame:
    def __init__(self):
        self.cursor = (0, 0)
        self.puzzle_mode = False # Direct vs Ripple
        self.state = [[False]*3 for _ in range(3)]
        self.original_state = [[False]*3 for _ in range(3)]
        self.status_msg = "Hardware matrix probed. Press Space to toggle, Enter to commit."
        self.status_color = CYAN
        self.probe()

    def probe(self):
        st = probe_hardware_state()
        idx = 0
        for r in range(3):
            for c in range(3):
                self.state[r][c] = st[idx]
                self.original_state[r][c] = st[idx]
                idx += 1

    def move(self, dr, dc):
        self.cursor = (max(0, min(2, self.cursor[0] + dr)), max(0, min(2, self.cursor[1] + dc)))

    def toggle(self):
        r, c = self.cursor
        if self.puzzle_mode:
            # Flip cell and 4 neighbors
            for dr, dc in [(0, 0), (-1, 0), (1, 0), (0, -1), (0, 1)]:
                nr, nc = r + dr, c + dc
                if 0 <= nr < 3 and 0 <= nc < 3:
                    self.state[nr][nc] = not self.state[nr][nc]
            self.status_msg = f"[RIPPLE] Toggled cell ({r+1}, {c+1}) and adjacent matrix nodes."
            self.status_color = VIOLET
        else:
            self.state[r][c] = not self.state[r][c]
            item = ITEMS[r * 3 + c]
            state_str = "ENABLED" if self.state[r][c] else "DISABLED"
            self.status_msg = f"[STAGED] {item['name']} -> {state_str} (Press Enter to write)"
            self.status_color = AMBER
        print("\a", end="", flush=True)

    def apply_preset(self, num):
        if num == 1: # Stealth
            self.state = [[False, False, True], [True, False, False], [False, False, True]]
            self.status_msg = "[PRESET] Loaded 'Full Stealth' profile matrix."
        elif num == 2: # Gaming
            self.state = [[True, False, False], [True, True, True], [False, False, False]]
            self.status_msg = "[PRESET] Loaded 'Gaming Rig' profile matrix."
        elif num == 3: # Focus
            self.state = [[True, False, True], [True, False, True], [False, True, False]]
            self.status_msg = "[PRESET] Loaded 'Focus Work' profile matrix."
        elif num == 4: # Default
            self.state = [[True, True, False], [False, False, True], [True, True, False]]
            self.status_msg = "[PRESET] Loaded 'Balanced Desktop' profile matrix."
        self.status_color = GREEN
        print("\a", end="", flush=True)

    def commit(self):
        idx = 0
        changed = 0
        for r in range(3):
            for c in range(3):
                item = ITEMS[idx]
                if self.state[r][c] != self.original_state[r][c]:
                    commit_hardware_state(item, self.state[r][c])
                    self.original_state[r][c] = self.state[r][c]
                    changed += 1
                idx += 1
        self.status_msg = f"[COMMITTED] Applied {changed} subsystem profile state changes live!"
        self.status_color = GREEN
        print("\a", end="", flush=True)

    def render(self, term_w=80, term_h=36):
        card_w = min(term_w - 2, 78)
        card_h = min(term_h - 2, 34)
        left = max(0, (term_w - card_w) // 2)
        top = max(0, (term_h - card_h) // 2)
        right = left + card_w - 1
        bottom = top + card_h - 1

        buf = []
        buf.append(f"{ESC}?25l{ESC}2J{ESC}H{BG_DARK}")

        # Bento Card
        span = "─" * (card_w - 2)
        buf.append(f"{ESC}{top+1};{left+1}H{BORDER_VIOLET}┌{span}┐")
        for y in range(top + 2, bottom + 1):
            buf.append(f"{ESC}{y};{left+1}H{BORDER_VIOLET}│{ESC}{y};{right+1}H{BORDER_VIOLET}│")
        buf.append(f"{ESC}{top+3};{left+1}H{BORDER_VIOLET}├{span}┤")
        buf.append(f"{ESC}{bottom-2};{left+1}H{BORDER_VIOLET}├{span}┤")
        buf.append(f"{ESC}{bottom+1};{left+1}H{BORDER_VIOLET}└{span}┘")

        # Header
        mode_str = "PUZZLE RIPPLE" if self.puzzle_mode else "DIRECT TOGGLE"
        header_title = f"{BORDER_VIOLET}[ ⮽ ] {CYAN}[ LIGHTS OUT // QUICK SETTINGS & PROFILE MATRIX ]"
        mode_tag = f"{AMBER}[ MODE: {mode_str} ]"
        buf.append(f"{ESC}{top+2};{left+3}H{header_title}")
        buf.append(f"{ESC}{top+2};{right - len(mode_tag) - 1}H{mode_tag}")

        # 3x3 Bento Tile Matrix
        tile_w = 22
        tile_h = 5
        start_x = left + 4
        start_y = top + 5

        for r in range(3):
            for c in range(3):
                idx = r * 3 + c
                item = ITEMS[idx]
                is_on = self.state[r][c]
                is_cur = (r == self.cursor[0] and c == self.cursor[1])

                tx = start_x + c * (tile_w + 2)
                ty = start_y + r * (tile_h + 1)

                border_col = CYAN if is_cur else (BORDER_VIOLET if is_on else WALL_COLOR)
                bg_col = TOGGLE_ACTIVE_BG if is_on else TOGGLE_INACTIVE_BG
                state_lbl = f"{GREEN}● ON {RESET}{bg_col}" if is_on else f"{TEXT_DIM}○ OFF{RESET}{bg_col}"

                t_span = "─" * (tile_w - 2)
                buf.append(f"{ESC}{ty};{tx}H{border_col}┌{t_span}┐{RESET}{BG_DARK}")
                buf.append(f"{ESC}{ty+1};{tx}H{border_col}│{bg_col}{BOLD}{item['glyph']} {item['name']:<14}{RESET}{BG_DARK}{border_col}│{RESET}{BG_DARK}")
                buf.append(f"{ESC}{ty+2};{tx}H{border_col}│{bg_col}{state_lbl:<19}{RESET}{BG_DARK}{border_col}│{RESET}{BG_DARK}")
                buf.append(f"{ESC}{ty+3};{tx}H{border_col}│{bg_col}{TEXT_DIM}[KEY: {idx+1}]{' '*12}{RESET}{BG_DARK}{border_col}│{RESET}{BG_DARK}")
                buf.append(f"{ESC}{ty+4};{tx}H{border_col}└{t_span}┘{RESET}{BG_DARK}")

        # Presets Bar
        p_row = top + 24
        buf.append(f"{ESC}{p_row};{left+4}H{VIOLET}{BOLD}[ PRESETS ]{RESET}{BG_DARK} {AMBER}[1]{TEXT_WHITE} Stealth  {AMBER}[2]{TEXT_WHITE} Gaming  {AMBER}[3]{TEXT_WHITE} Focus  {AMBER}[4]{TEXT_WHITE} Balanced")

        # Status Line
        buf.append(f"{ESC}{bottom-3};{left+3}H{self.status_color}{self.status_msg[:card_w-6]:<{card_w-6}}{RESET}{BG_DARK}")

        # Footer
        footer_badge = f"{CYAN}[ NORMAL ]{RESET}{BG_DARK}"
        footer_keys = f"{TEXT_DIM}h/j/k/l Move • Space Toggle • Enter Commit • m Mode • 1-4 Preset • q Exit{RESET}{BG_DARK}"
        buf.append(f"{ESC}{bottom-1};{left+3}H{footer_badge}  {footer_keys}")

        buf.append(f"{ESC}{term_h};1H{RESET}")
        sys.stdout.write("".join(buf))
        sys.stdout.flush()

def main():
    old_settings = termios.tcgetattr(sys.stdin)
    try:
        tty.setraw(sys.stdin.fileno())
        game = LightsOutGame()
        while True:
            try:
                h, w = os.get_terminal_size()
            except Exception:
                w, h = 80, 36
            game.render(w, h)

            ch = sys.stdin.read(1)
            if ch in ('q', 'Q', '\x1b'):
                break
            elif ch in ('h', 'a'): game.move(0, -1)
            elif ch in ('l', 'd'): game.move(0, 1)
            elif ch in ('k', 'w'): game.move(-1, 0)
            elif ch in ('j', 's'): game.move(1, 0)
            elif ch == ' ': game.toggle()
            elif ch in ('\r', '\n'): game.commit()
            elif ch in ('m', 'M'):
                game.puzzle_mode = not game.puzzle_mode
                mode_str = "PUZZLE RIPPLE" if game.puzzle_mode else "DIRECT TOGGLE"
                game.status_msg = f"[MODE] Switched to {mode_str}."
                game.status_color = VIOLET
            elif ch in ('1', '2', '3', '4'):
                game.apply_preset(int(ch))
            elif ch in ('r', 'R'):
                game.probe()
                game.status_msg = "[REFRESH] Polled live hardware state."
                game.status_color = CYAN
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        sys.stdout.write(f"{ESC}?25h\n{RESET}")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
