def draw_text(cr, text, x, y, font_desc_str, color, align="center"):
    layout = PangoCairo.create_layout(cr)
    desc = Pango.FontDescription(font_desc_str)
    layout.set_font_description(desc)
    layout.set_text(text, -1)
    ink, logical = layout.get_pixel_extents()

    if align == "center":
        tx = x - logical.width / 2.0
    elif align == "right":
        tx = x - logical.width
    else:
        tx = x
    ty = y - logical.height / 2.0

    cr.move_to(tx, ty)
    cr.set_source_rgb(*color)
    PangoCairo.show_layout(cr, layout)
    return logical.width, logical.height

# ---------------------------------------------------------------------------
# Linux PAM Ctypes Binding
# ---------------------------------------------------------------------------
try:
    libpam = ctypes.CDLL("libpam.so.0")
    libc = ctypes.CDLL("libc.so.6")

    libc.strdup.restype = ctypes.c_void_p
    libc.strdup.argtypes = [ctypes.c_char_p]
    libc.calloc.restype = ctypes.c_void_p
    libc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]
except Exception:
    libpam = None
    libc = None

class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]

class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]

PAM_PROMPT_ECHO_OFF = 1
PAM_PROMPT_ECHO_ON = 2
PAM_CONV_FUNC = ctypes.CFUNCTYPE(
    ctypes.c_int,
    ctypes.c_int,
    ctypes.POINTER(ctypes.POINTER(PamMessage)),
    ctypes.POINTER(ctypes.POINTER(PamResponse)),
    ctypes.c_void_p
)

class PamConv(ctypes.Structure):
    _fields_ = [("conv", PAM_CONV_FUNC), ("appdata_ptr", ctypes.c_void_p)]

if libpam:
    libpam.pam_start.restype = ctypes.c_int
    libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(PamConv), ctypes.POINTER(ctypes.c_void_p)]
    libpam.pam_authenticate.restype = ctypes.c_int
    libpam.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]
    libpam.pam_end.restype = ctypes.c_int
    libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]

def pam_authenticate_user(username: str, password: str, service: str = "swaylock") -> bool:
    if not libpam or not libc:
        return False
    pw_bytes = password.encode('utf-8')

    # Resolve single valid PAM service (swaylock -> login -> system-auth)
    target_service = service
    if not os.path.exists(f"/etc/pam.d/{target_service}"):
        for s in ["login", "system-auth"]:
            if os.path.exists(f"/etc/pam.d/{s}"):
                target_service = s
                break

    def conv_cb(n_msgs, msgs, resp, appdata):
        resp_ptr = libc.calloc(n_msgs, ctypes.sizeof(PamResponse))
        r_arr = (PamResponse * n_msgs).from_address(resp_ptr)
        for i in range(n_msgs):
            m = msgs[i].contents
            if m.msg_style in (PAM_PROMPT_ECHO_OFF, PAM_PROMPT_ECHO_ON):
                r_arr[i].resp = libc.strdup(pw_bytes)
                r_arr[i].resp_retcode = 0
            else:
                r_arr[i].resp = None
                r_arr[i].resp_retcode = 0
        resp[0] = ctypes.cast(resp_ptr, ctypes.POINTER(PamResponse))
        return 0

    conv_func = PAM_CONV_FUNC(conv_cb)
    conv = PamConv(conv_func, None)
    pam_h = ctypes.c_void_p()

    ret = libpam.pam_start(target_service.encode('utf-8'), username.encode('utf-8'), ctypes.byref(conv), ctypes.byref(pam_h))
    if ret != 0:
        return False

    auth_ret = libpam.pam_authenticate(pam_h, 0)
    libpam.pam_end(pam_h, auth_ret)
    return auth_ret == 0

# ---------------------------------------------------------------------------
# Strict Polyomino Minimalist Tron Tokens & Shaders
#
# Colors follow the currently active polyomino.dotfiles sway theme
# (~/.config/polyomino/theme/state -> themes/palettes/<FLAVOR>.conf), with
# the values below kept as the built-in fallback if that theme data can't
# be found (e.g. running the script outside the dotfiles checkout).
# ---------------------------------------------------------------------------
def _hex_to_rgb(hex_str):
    h = hex_str.strip().strip('"').strip("'").lstrip('#')
    return (int(h[0:2], 16) / 255, int(h[2:4], 16) / 255, int(h[4:6], 16) / 255)


def _lighten(rgb, amount=0.35):
    return tuple(c + (1.0 - c) * amount for c in rgb)


def _load_theme_palette():
    """Parse the active theme's palette .conf (shell KEY="value" pairs)."""
    state_file = os.path.expanduser("~/.config/polyomino/theme/state")
    flavor = None
    try:
        with open(state_file, "r") as f:
            for line in f:
                if line.startswith("FLAVOR="):
                    flavor = line.strip().split("=", 1)[1]
                    break
    except OSError:
        return None
    if not flavor:
        return None

    repo_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))))
    palette_file = os.path.join(repo_root, "themes", "palettes", f"{flavor}.conf")

    values = {}
    try:
        with open(palette_file, "r") as f:
            for line in f:
                stripped = line.strip()
                if not stripped or stripped.startswith('#') or "=" not in stripped:
                    continue
                key, _, rest = stripped.partition("=")
                key = key.strip()
                rest = rest.strip()
                if rest[:1] in ('"', "'"):
                    quote = rest[0]
                    end = rest.find(quote, 1)
                    val = rest[1:end] if end != -1 else rest[1:]
                else:
                    val = rest.split('#', 1)[0].strip()
                values[key] = val
    except OSError:
        return None

    required = ("BASE", "MANTLE", "BLUE", "TEAL", "RED")
    if not all(k in values for k in required):
        return None
    return values


def _load_theme_colors():
    defaults = {
        "COLOR_BG": (15 / 255, 17 / 255, 23 / 255),            # #0F1117
        "COLOR_GLASS": (25 / 255, 28 / 255, 36 / 255),          # #191C24
        "COLOR_RESTING_TEAL": (0 / 255, 210 / 255, 211 / 255),  # #00D2D3
        "COLOR_ACTIVE_GOLD": (235 / 255, 180 / 255, 52 / 255),  # #EBB434
        "COLOR_CLEAR_CYAN": (85 / 255, 239 / 255, 196 / 255),   # #55EFC4
        "COLOR_REJECT_RED": (238 / 255, 82 / 255, 83 / 255),    # #EE5253
    }

    palette = _load_theme_palette()
    if not palette:
        return defaults

    try:
        base = _hex_to_rgb(palette["BASE"])
        glass = _hex_to_rgb(palette["MANTLE"])
        active = _hex_to_rgb(palette["BLUE"])    # primary accent token
        resting = _hex_to_rgb(palette["TEAL"])   # secondary accent token
        reject = _hex_to_rgb(palette["RED"])
        clear = _lighten(resting, 0.35)
        return {
            "COLOR_BG": base,
            "COLOR_GLASS": glass,
            "COLOR_RESTING_TEAL": resting,
            "COLOR_ACTIVE_GOLD": active,
            "COLOR_CLEAR_CYAN": clear,
            "COLOR_REJECT_RED": reject,
        }
    except (KeyError, ValueError):
        return defaults


_THEME_COLORS = _load_theme_colors()
COLOR_BG = _THEME_COLORS["COLOR_BG"]
COLOR_GLASS = _THEME_COLORS["COLOR_GLASS"]
COLOR_RESTING_TEAL = _THEME_COLORS["COLOR_RESTING_TEAL"]
COLOR_ACTIVE_GOLD = _THEME_COLORS["COLOR_ACTIVE_GOLD"]
