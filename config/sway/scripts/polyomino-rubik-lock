def _clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))

def _mix(c1, c2, t):
    return (
        _clamp(c1[0] + (c2[0] - c1[0]) * t),
        _clamp(c1[1] + (c2[1] - c1[1]) * t),
        _clamp(c1[2] + (c2[2] - c1[2]) * t)
    )

# Classic Tetris Piece Colors from PowerMenu.scala
PIECE_COLORS = [
    (0 / 255, 210 / 255, 214 / 255),   # 0: Front (+Z) I - Cyan
    (245 / 255, 158 / 255, 66 / 255),  # 1: Back (-Z)  L - Orange
    (242 / 255, 201 / 255, 76 / 255),  # 2: Up (+Y)    O - Yellow / Gold
