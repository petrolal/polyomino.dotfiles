#!/usr/bin/env python3
"""
polyomino-2048 — Memory & Core Cache Compact Utility (2048 Puzzle)
Part of Polyomino Dotfiles Suite.
"""

import sys
import os
import random
import subprocess
import termios
import tty
import time

ESC = "\033["
RESET = f"{ESC}0m"
BOLD = f"{ESC}1m"
DIM = f"{ESC}2m"

BG_DARK = f"{ESC}48;2;15;17;26m"
BORDER_VIOLET = f"{ESC}38;2;139;92;246m"
CYAN = f"{ESC}38;2;6;182;212m"
AMBER = f"{ESC}38;2;245;158;11m"
VIOLET = f"{ESC}38;2;168;85;247m"
GREEN = f"{ESC}38;2;34;197;94m"
RED = f"{ESC}38;2;239;68;68m"
TEXT_WHITE = f"{ESC}38;2;248;250;252m"
TEXT_DIM = f"{ESC}38;2;100;116;139m"

TIER_COLORS = {
    2: (f"{ESC}38;2;148;163;184m", f"{ESC}48;2;30;41;59m"),
    4: (f"{ESC}38;2;148;163;184m", f"{ESC}48;2;51;65;85m"),
    8: (f"{ESC}38;2;6;182;212m", f"{ESC}48;2;15;23;42m"),
    16: (f"{ESC}38;2;56;189;248m", f"{ESC}48;2;12;74;110m"),
    32: (f"{ESC}38;2;59;130;246m", f"{ESC}48;2;30;58;138m"),
    64: (f"{ESC}38;2;168;85;247m", f"{ESC}48;2;88;28;135m"),
    128: (f"{ESC}38;2;192;132;252m", f"{ESC}48;2;107;33;168m"),
    256: (f"{ESC}38;2;245;158;11m", f"{ESC}48;2;120;53;15m"),
    512: (f"{ESC}38;2;251;191;36m", f"{ESC}48;2;146;64;14m"),
    1024: (f"{ESC}38;2;34;197;94m", f"{ESC}48;2;20;83;45m"),
    2048: (f"{ESC}38;2;239;68;68m", f"{ESC}48;2;127;29;29m")
}

def get_meminfo():
    """Read system memory metrics."""
    data = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    k = parts[0].strip()
                    v = parts[1].strip().split()[0]
                    data[k] = int(v) // 1024  # Convert to MB
        total = data.get("MemTotal", 16384)
        avail = data.get("MemAvailable", 8192)
        buffers = data.get("Buffers", 512)
        cached = data.get("Cached", 4096)
        used = total - avail
        swap_total = data.get("SwapTotal", 0)
        swap_free = data.get("SwapFree", 0)
        swap_used = swap_total - swap_free
        return {
            "total": total,
            "used": used,
            "free": data.get("MemFree", 0),
            "avail": avail,
            "buffers": buffers,
            "cached": cached,
            "swap_used": swap_used,
            "swap_total": swap_total
        }
    except Exception:
        return {"total": 16384, "used": 6144, "free": 4096, "avail": 10240, "buffers": 512, "cached": 3584, "swap_used": 0, "swap_total": 8192}

def trigger_cache_sync():
    """Execute background sync to compact dirty caches."""
    try:
        subprocess.run(["sync"], timeout=1, capture_output=True)
    except Exception:
        pass

class Game2048:
    def __init__(self):
        self.grid = [[0]*4 for _ in range(4)]
        self.score = 0
        self.reclaimed_mb = 0
        self.merges = 0
        self.status_msg = "Slide matching memory blocks to compact kernel caches."
        self.status_color = CYAN
        self.spawn()
        self.spawn()
        self.mem = get_meminfo()

    def spawn(self):
        empty = [(r, c) for r in range(4) for c in range(4) if self.grid[r][c] == 0]
        if empty:
            r, c = random.choice(empty)
            self.grid[r][c] = 4 if random.random() > 0.85 else 2

    def compress(self, row):
        new_row = [x for x in row if x != 0]
        new_row += [0] * (4 - len(new_row))
        return new_row

    def merge(self, row):
        merged = False
        for i in range(3):
            if row[i] != 0 and row[i] == row[i+1]:
                val = row[i] * 2
                row[i] = val
                row[i+1] = 0
                self.score += val
                self.reclaimed_mb += val // 2
                self.merges += 1
                merged = True
        return row, merged

    def move_left(self):
        moved = False
        for r in range(4):
            c1 = self.compress(self.grid[r])
            m, merged = self.merge(c1)
            c2 = self.compress(m)
            if c2 != self.grid[r]:
                moved = True
                self.grid[r] = c2
        return moved

    def rotate(self):
        self.grid = [list(r) for r in zip(*self.grid[::-1])]

    def move(self, direction):
        # 0: left, 1: down, 2: right, 3: up
        moved = False
        for _ in range(direction):
            self.rotate()
        moved = self.move_left()
        for _ in range((4 - direction) % 4):
            self.rotate()
        
        if moved:
            self.spawn()
            trigger_cache_sync()
            self.mem = get_meminfo()
            self.status_msg = f"[COMPACT] Reclaimed {self.reclaimed_mb} MB cache buffers • Sync executed."
            self.status_color = GREEN
            print("\a", end="", flush=True)

    def render(self, term_w=80, term_h=36):
        card_w = min(term_w - 2, 78)
        card_h = min(term_h - 2, 34)
        left = max(0, (term_w - card_w) // 2)
        top = max(0, (term_h - card_h) // 2)
        right = left + card_w - 1
        bottom = top + card_h - 1

        buf = []
        buf.append(f"{ESC}?25l{ESC}2J{ESC}H{BG_DARK}")

        # Bento Card
        span = "─" * (card_w - 2)
        buf.append(f"{ESC}{top+1};{left+1}H{BORDER_VIOLET}┌{span}┐")
        for y in range(top + 2, bottom + 1):
            buf.append(f"{ESC}{y};{left+1}H{BORDER_VIOLET}│{ESC}{y};{right+1}H{BORDER_VIOLET}│")
        buf.append(f"{ESC}{top+3};{left+1}H{BORDER_VIOLET}├{span}┤")
        buf.append(f"{ESC}{bottom-2};{left+1}H{BORDER_VIOLET}├{span}┤")
        buf.append(f"{ESC}{bottom+1};{left+1}H{BORDER_VIOLET}└{span}┘")

        # Header
        header_title = f"{BORDER_VIOLET}[ ⮽ ] {CYAN}[ 2048 // MEMORY & CACHE COMPACTION ]"
        score_tag = f"{AMBER}[ COMPACTED: {self.reclaimed_mb} MB ] [ SCORE: {self.score} ]"
        buf.append(f"{ESC}{top+2};{left+3}H{header_title}")
        buf.append(f"{ESC}{top+2};{right - len(score_tag) - 1}H{score_tag}")

        # Live RAM Telemetry Gauge (Left Panel)
        tl_left = left + 4
        tl_top = top + 5
        used_pct = int(self.mem["used"] / max(1, self.mem["total"]) * 100)
        cache_mb = self.mem["cached"] + self.mem["buffers"]
        cache_pct = int(cache_mb / max(1, self.mem["total"]) * 100)
        
        buf.append(f"{ESC}{tl_top};{tl_left}H{VIOLET}{BOLD}[ LIVE KERNEL TELEMETRY ]{RESET}{BG_DARK}")
        buf.append(f"{ESC}{tl_top+2};{tl_left}H{TEXT_DIM}RAM USED:    {TEXT_WHITE}{self.mem['used']} / {self.mem['total']} MB ({used_pct}%)")
        
        # RAM Bar
        bar_len = 24
        used_bars = int(bar_len * (used_pct / 100.0))
        ram_bar = f"{RED}{'█'*used_bars}{TEXT_DIM}{'░'*(bar_len-used_bars)}{RESET}{BG_DARK}"
        buf.append(f"{ESC}{tl_top+3};{tl_left}H[{ram_bar}]")

        buf.append(f"{ESC}{tl_top+5};{tl_left}H{TEXT_DIM}CACHE/BUFF:  {TEXT_WHITE}{cache_mb} MB ({cache_pct}%)")
        cache_bars = int(bar_len * (cache_pct / 100.0))
        c_bar = f"{AMBER}{'█'*cache_bars}{TEXT_DIM}{'░'*(bar_len-cache_bars)}{RESET}{BG_DARK}"
        buf.append(f"{ESC}{tl_top+6};{tl_left}H[{c_bar}]")

        buf.append(f"{ESC}{tl_top+8};{tl_left}H{TEXT_DIM}COMPACTION:  {GREEN}{self.merges} pages merged")
        buf.append(f"{ESC}{tl_top+9};{tl_left}H{TEXT_DIM}SWAP USED:   {TEXT_WHITE}{self.mem['swap_used']} / {self.mem['swap_total']} MB")

        # 2048 4x4 Tile Matrix (Right Panel)
        grid_left = left + 34
        grid_top = top + 5

        for r in range(4):
            for c in range(4):
                val = self.grid[r][c]
                rx = grid_left + c * 9
                ry = grid_top + r * 3
                if val == 0:
                    buf.append(f"{ESC}{ry};{rx}H{TEXT_DIM}┌───────┐")
                    buf.append(f"{ESC}{ry+1};{rx}H{TEXT_DIM}│       │")
                    buf.append(f"{ESC}{ry+2};{rx}H{TEXT_DIM}└───────┘")
                else:
                    fg, bg = TIER_COLORS.get(val, (TEXT_WHITE, f"{ESC}48;2;30;41;59m"))
                    lbl = f"{val}M" if val < 1024 else f"{val//1024}G"
                    buf.append(f"{ESC}{ry};{rx}H{fg}┌───────┐{RESET}{BG_DARK}")
                    buf.append(f"{ESC}{ry+1};{rx}H{fg}│{BOLD}{bg}{lbl:^7}{RESET}{BG_DARK}{fg}│{RESET}{BG_DARK}")
                    buf.append(f"{ESC}{ry+2};{rx}H{fg}└───────┘{RESET}{BG_DARK}")

        # Status Line
        buf.append(f"{ESC}{bottom-3};{left+3}H{self.status_color}{self.status_msg[:card_w-6]:<{card_w-6}}{RESET}{BG_DARK}")

        # Footer
        footer_badge = f"{CYAN}[ NORMAL ]{RESET}{BG_DARK}"
        footer_keys = f"{TEXT_DIM}h/j/k/l (←/↓/↑/→) Slide • c Force Sync • r New Game • q/Esc Exit{RESET}{BG_DARK}"
        buf.append(f"{ESC}{bottom-1};{left+3}H{footer_badge}  {footer_keys}")

        buf.append(f"{ESC}{term_h};1H{RESET}")
        sys.stdout.write("".join(buf))
        sys.stdout.flush()

def main():
    old_settings = termios.tcgetattr(sys.stdin)
    try:
        tty.setraw(sys.stdin.fileno())
        game = Game2048()
        while True:
            try:
                h, w = os.get_terminal_size()
            except Exception:
                w, h = 80, 36
            game.render(w, h)

            ch = sys.stdin.read(1)
            if ch in ('q', 'Q', '\x1b'):
                break
            elif ch in ('h', 'a'): game.move(0)
            elif ch in ('j', 's'): game.move(1)
            elif ch in ('l', 'd'): game.move(2)
            elif ch in ('k', 'w'): game.move(3)
            elif ch in ('c', 'C'):
                trigger_cache_sync()
                game.mem = get_meminfo()
                game.status_msg = "[FLUSH] Forced kernel buffer sync completed."
                game.status_color = GREEN
            elif ch in ('r', 'R'):
                game = Game2048()
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)
        sys.stdout.write(f"{ESC}?25h\n{RESET}")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
