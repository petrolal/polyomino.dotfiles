/* Generated by polyomino.dotfiles theme engine — flavor=encruza */
* {
    bg: #161B22;
    fg: #F0F6FC;
    accent: #EE5253;
    mantle: #0D1117;
    border-col: #EE5253;
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    text-color: @fg;
    border: 2px;
    border-color: @border-col;
    border-radius: 0px;
    padding: 12px;
    width: 680px;
}
mainbox {
    children: [ inputbar, listview ];
}
inputbar {
    children: [ prompt, entry ];
    background-color: @mantle;
    border: 1px solid @border-col;
    border-radius: 0px;
    padding: 6px 10px;
    margin: 0 0 10px 0;
}
prompt {
    background-color: @accent;
    text-color: #0D1117;
    padding: 4px 8px;
    border-radius: 0px;
    font-weight: bold;
}
entry {
    placeholder: "Search apps...";
    placeholder-color: #6c7086;
    padding: 4px 8px;
    text-color: @fg;
}
listview {
    lines: 6;
    columns: 2;
    fixed-height: false;
}
element {
    padding: 6px 10px;
    border-radius: 0px;
    background-color: @mantle;
    margin: 2px 4px;
    border: 1px solid transparent;
}
element selected {
    background-color: @accent;
    text-color: #0D1117;
    border-radius: 0px;
    border: 1px solid @accent;
}
element-text {
    text-color: inherit;
}
element-icon {
    size: 24px;
    margin: 0 8px 0 0;
}
