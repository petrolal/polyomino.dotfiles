/* Generated by polyomino.dotfiles theme engine — flavor=matriz */
* {
    bg: #0D1117;
    fg: #F0F6FC;
    accent: #8B5CF6;
    mantle: #161B22;
    surface: #1C2128;
    border-col: #8B5CF6;
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    text-color: @fg;
    border: 1px;
    border-color: @border-col;
    border-radius: 8px;
    padding: 14px;
    width: 680px;
}
mainbox {
    children: [ inputbar, listview ];
}
inputbar {
    children: [ prompt, entry ];
    background-color: @mantle;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 6px 10px;
    margin: 0 0 10px 0;
}
prompt {
    background-color: @accent;
    text-color: #0D1117;
    padding: 4px 10px;
    border-radius: 4px;
    font-weight: bold;
}
entry {
    placeholder: "Search applications...";
    placeholder-color: #8B949E;
    padding: 4px 8px;
    text-color: @fg;
}
listview {
    lines: 6;
    columns: 2;
    fixed-height: false;
}
element {
    padding: 8px 12px;
    border-radius: 6px;
    background-color: @surface;
    margin: 3px 4px;
    border: 1px solid #30363D;
}
element selected {
    background-color: @accent;
    text-color: #0D1117;
    border-radius: 6px;
    border: 1px solid @accent;
}
element-text {
    text-color: inherit;
}
element-icon {
    size: 24px;
    margin: 0 8px 0 0;
}
