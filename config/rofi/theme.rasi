/* Generated by polyomino.dotfiles theme engine — flavor=matriz */
* {
    bg: #191C24;
    fg: #F8FAFC;
    accent: #EBB434;
    mantle: #0F1117;
    border-col: #EBB434;
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    text-color: @fg;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    padding: 12px;
    width: 680px;
}
mainbox {
    children: [ inputbar, listview ];
}
inputbar {
    children: [ prompt, entry ];
    background-color: @mantle;
    border-radius: 8px;
    padding: 8px;
    margin: 0 0 12px 0;
}
prompt {
    background-color: @accent;
    text-color: #0F1117;
    padding: 4px 8px;
    border-radius: 6px;
}
entry {
    placeholder: "Search apps...";
    placeholder-color: #6c7086;
    padding: 4px 8px;
    text-color: @fg;
}
listview {
    lines: 6;
    columns: 2;
    fixed-height: false;
}
element {
    padding: 8px 12px;
    border-radius: 8px;
    background-color: @mantle;
    margin: 2px 4px;
}
element selected {
    background-color: @accent;
    text-color: #0F1117;
    border-radius: 8px;
}
element-text {
    text-color: inherit;
}
element-icon {
    size: 24px;
    margin: 0 8px 0 0;
}
