/* Generated by polyomino.dotfiles theme engine — flavor=matriz */
* {
    bg: #0D1117;
    fg: #F0F6FC;
    accent: #8B5CF6;
    accent-active: #a855f7;
    mantle: #161B22;
    surface: #1C2128;
    surface-selected: #21262D;
    border-subtle: rgba(139, 92, 246, 0.4);
    border-active: #a855f7;
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}
window {
    background-color: @bg;
    text-color: @fg;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 8px;
    padding: 16px;
    width: 960px;
}
mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}
inputbar {
    enabled: true;
    children: [ prompt, entry ];
    background-color: @mantle;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 6px;
    padding: 8px 12px;
    spacing: 8px;
    margin: 0px 0px 4px 0px;
}
prompt {
    enabled: true;
    background-color: @accent;
    text-color: #0D1117;
    padding: 4px 10px;
    border-radius: 4px;
    font: "JetBrainsMono Nerd Font Bold 11";
}
entry {
    enabled: true;
    placeholder: "Search shortcuts & actions...";
    placeholder-color: #8B949E;
    padding: 4px 8px;
    text-color: @fg;
    cursor: text;
}
listview {
    enabled: true;
    columns: 2;
    lines: 10;
    spacing: 8px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: false;
}
element {
    orientation: horizontal;
    children: [ element-text ];
    spacing: 8px;
    padding: 10px 14px;
    border-radius: 6px;
    background-color: @surface;
    border: 1px;
    border-color: @border-subtle;
    text-color: @fg;
}
element normal.normal {
    background-color: @surface;
    text-color: @fg;
    border: 1px;
    border-color: @border-subtle;
    border-radius: 6px;
}
element selected.normal, element selected.active {
    background-color: @surface-selected;
    text-color: @fg;
    border: 1px;
    border-color: @border-active;
    border-radius: 6px;
}
element-text {
    markup: true;
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 11";
    expand: true;
}
