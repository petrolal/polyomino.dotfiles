// Fastfetch configuration for Polyomino dotfiles suite
// Location: config/fastfetch/config.jsonc
{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "file",
		"source": "~/.config/fastfetch/assets/current_logo.txt",
		"color": {
			"1": "yellow",
			"2": "cyan",
			"3": "red"
		},
		"padding": {
			"right": 2
		}
	},
	"display": {
		"separator": "  ·  "
	},
	"modules": [
		"title",
		"separator",
		"os",
		{
			"type": "command",
			"key": "Theme",
			"text": "grep '^FLAVOR=' ~/.config/polyomino/theme/state 2>/dev/null | cut -d= -f2- || echo 'matriz'"
		},
		"kernel",
		"uptime",
		"break",
		{
			"type": "wm",
			"key": "WM"
		},
		"terminal",
		"shell",
		"break",
		{
			"type": "cpu",
			"format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
		},
		"gpu",
		"memory",
		{
			"type": "disk",
			"key": "Disk"
		},
		"break",
		"colors"
	]
}
