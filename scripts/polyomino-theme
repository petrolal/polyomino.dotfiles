#!/usr/bin/env bash
# polyomino theme wrapper - delegates to Scala native CLI
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v polyomino &>/dev/null; then
  exec polyomino theme "$@"
elif [ -x "$HOME/.local/bin/polyomino" ]; then
  exec "$HOME/.local/bin/polyomino" theme "$@"
elif [ -x "$SCRIPT_DIR/target/native-image/polyomino" ]; then
  exec "$SCRIPT_DIR/target/native-image/polyomino" theme "$@"
else
  cd "$SCRIPT_DIR" && sbt "run theme $*"
fi
